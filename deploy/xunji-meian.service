[Unit]
Description=Xunji Meian Django API
After=network.target

[Service]
User=admin
Group=www-data
WorkingDirectory=/home/admin/xunji-meian/backend
EnvironmentFile=/home/admin/xunji-meian/backend/.env
ExecStart=/home/admin/xunji-meian/backend/.venv/bin/gunicorn xunjimeian.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
